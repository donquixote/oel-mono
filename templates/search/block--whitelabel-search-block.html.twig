{#
/**
 * @file
 * Override for blocks with plugin id = 'whitelabel_search_block'.
 *
 * Removes outer wrapper div and block label.
 *
 * @see \Drupal\oe_whitelabel_search\Plugin\Block\SearchBlock
 */
#}
{% block content %}
<div class="search-dropdown dropdown">
  {{ pattern('button', {
    'variant': 'ghost',
    'icon': 'search',
    'attributes': attributes
      .setAttribute('data-bs-toggle', 'dropdown')
      .setAttribute('aria-haspopup', 'true')
      .setAttribute('aria-expanded', 'false')
      .addClass([
        'dropdown-toggle',
        'd-xl-none',
        'px-2',
      ])
  }) }}
  <div class="dropdown-menu px-3 px-xl-0 d-xl-block me-2-5">
    {{ content }}
  </div>
</div>
{% endblock %}
