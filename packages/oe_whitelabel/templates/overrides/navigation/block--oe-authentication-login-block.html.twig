{#
/**
 * @file
 * Override for blocks with plugin id = 'oe_authentication_login_block'.
 *
 * @see \Drupal\oe_authentication\Plugin\Block\LoginBlock
 */
#}
{% set extra_attributes = create_attribute() %}
{% set extra_attributes = extra_attributes.addClass([
  'text-center'
]) %}

{% set link_title %}
  {{ pattern('icon', {
    name: 'person-fill',
    size: 'xs',
  }) }}
  <span class="d-none d-xl-inline-block">{{ content['#title'] }}</span>
{% endset %}
{% set link_attributes = create_attribute(content['#attributes'] ?? [])
  .addClass(['d-flex', 'gap-2-5', 'nav-link'])
%}
<div class="oe-authentication d-flex">
  {{ link(link_title, content['#url'], link_attributes) }}
</div>
